# ============================================================
# Docker 环境变量模板 — 物业管理系统-业务端
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
#
# 用法（二选一）:
#   一键: bash scripts/deploy.sh    # 幂等：补齐缺失密钥 → 双端 compose up → 建库 → 监控冒烟
#   手工: cd service
#         cp .env.docker .env
#         php ../scripts/gen_env_keys.php --file=.env --replace-placeholders
#         docker compose up -d
#
# 密钥口径:
#   - change-me* 均为占位符，首次部署时由 gen_env_keys.php 替换为随机密钥
#   - 已存在的真实密钥绝不覆盖（旧密钥保留）；缺失键只做追加
#   - HASHIDS_SALT 必须与 admin 不同（有意隔离，见 admin/.env.docker）
#   - MySQL 容器的库名/用户/密码默认派生自下方 DB_DATABASE/DB_USERNAME/DB_PASSWORD
#   - .env 含全部密钥，已加入 .gitignore，切勿提交版本库
# 更多可选配置（支付/微信/支付宝/季节等）见 .env.example
# ============================================================

# ── 应用配置 ──
APP_NAME=物业管理系统-业务端
APP_DEBUG=false
# 容器对外入口是 nginx（默认 80/443），生产环境改为实际域名
APP_URL=http://localhost
# 容器内监听地址（compose 健康检查与 nginx 反代均指向 8788）
SERVER_LISTEN=http://0.0.0.0:8788
DOCS_ENABLED=false
LOG_LEVEL=info

# ── JWT 认证 ──
# 签名密钥，64 位以上（占位符由生成脚本替换；与 admin 端相互独立）
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_DEFAULT_EXPIRE=7200
JWT_REFRESH_EXPIRE=1209600
JWT_ISSUER=property-service
JWT_AUDIENCE=property-service
JWT_LEEWAY=60
JWT_STORAGE_TYPE=file
JWT_STORAGE_DATABASE=
JWT_STORAGE_PREFIX=jwt_token:

# ── Hashids ID 加解密 ──
# 口径：与 admin 必须不同（有意隔离，一端泄漏不至于对端 hashid 被反解）
HASHIDS_SALT=change-me-service-hashids-salt
HASHIDS_ALT_SALT=change-me-service-hashids-alt-salt

# ── Snowflake ID 生成 ──
# 工作节点 ID 与 admin(1) 不同，避免同库并发生成重复 ID
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=2
# 起始时间戳（毫秒）须与 admin 一致，否则跨端 ID 排序错乱
SNOWFLAKE_START_TIMESTAMP=1700000000000

# ── API 传输层加密 ──
ENCRYPTION_KEY=change-me-encryption-key
ENCRYPTION_CIPHER=AES-256-CBC
# 初始化向量（IV），CBC 模式需 16 字节，留空使用内置默认
ENCRYPTION_IV=

# ── 数据库存储层加密 ──
# 与传输密钥独立，不可共用；与 admin 各自独立
ENCRYPTABLE_KEY=change-me-encryptable-key
ENCRYPTABLE_CIPHER=AES-256-CBC
# 历史密钥列表（密钥轮换用），逗号分隔，只增不减
ENCRYPTION_PREVIOUS_KEYS=

# ── Elasticsearch（webman-scout） ──
SCOUT_DRIVER=elasticsearch
# 应用侧检索连接（凭证需与 ELASTIC_PASSWORD 一致，生成脚本会自动同步）
SCOUT_HOSTS=http://elastic:change-me-es-password@elasticsearch:9200
SCOUT_PREFIX=management_
SCOUT_SHARDS=1
SCOUT_REPLICAS=0
SCOUT_CHUNK_SIZE=500
SCOUT_SOFT_DELETE=true
# 插件层连接（非必填；容器内必须指向 elasticsearch 而非 localhost）
OPENSEARCH_HTTP_HOST=http://elasticsearch:9200
OPENSEARCH_USERNAME=elastic
OPENSEARCH_PASSWORD=change-me-es-password
OPENSEARCH_INDEX_PREFIX=management_
OPENSEARCH_SSL_VERIFICATION=false

# ── 点击验证码（poster-php） ──
POSTER_IMAGE_DRIVER=auto
POSTER_IMAGE_QUALITY=90
POSTER_CAPTCHA_STORAGE=auto
POSTER_CAPTCHA_TTL=300
POSTER_CAPTCHA_MAX_ATTEMPTS=3
POSTER_CAPTCHA_DIFFICULTY=medium

# ── 数据库连接 ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=management
DB_USERNAME=property_svc_user
DB_PASSWORD=change-me-db-password

# ── Redis 连接 ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DATABASE=0

# ── CORS 跨域 ──
# 允许的来源域名，生产环境改为实际前端域名
CORS_ALLOWED_ORIGIN=http://localhost

# ── Session 安全 ──
SESSION_SECURE=true
SESSION_SAME_SITE=Strict

# ── Elasticsearch 容器密码（同时被 compose 插值与 prometheus 抓取引用） ──
ELASTIC_PASSWORD=change-me-es-password

# ── Docker Compose 必填（docker-compose.yml 插值，缺失/空值会直接报错） ──
# REDIS_PASSWORD / ELASTIC_PASSWORD 同样被 compose 引用，同为必填（见上文）
MYSQL_ROOT_PASSWORD=change-me-root-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ── 端口覆盖（可选） ──
# 默认端口：nginx 80/443、MySQL 3307、Redis 6380、ES 9201、Prometheus 9091、Grafana 3001
# 同主机与 admin 双栈共存时，nginx 必须错开（admin 默认 80/443）:
# NGINX_PORT=8080
# NGINX_SSL_PORT=8443
# MYSQL_PORT=3307
# REDIS_PORT=6380
# ES_PORT=9201
# PROMETHEUS_PORT=9091
# GRAFANA_PORT=3001
