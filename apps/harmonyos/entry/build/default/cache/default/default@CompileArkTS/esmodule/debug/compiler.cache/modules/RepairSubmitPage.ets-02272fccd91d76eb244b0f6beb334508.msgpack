import router from '@ohos.router';
import { ApiService } from '../services/ApiService';
import { RepairRequest } from '../model/Models';

@Entry
@Component
struct RepairSubmitPage {
  @State category: number = 1;
  @State urgency: number = 0;
  @State description: string = '';
  @State roomId: string = '';
  private api: ApiService = ApiService.getInstance();

  async aboutToAppear(): Promise<void> {
    await this.api.init();
  }

  async submit(): Promise<void> {
    if (!this.description) return;
    try {
      let payload: RepairRequest = {
        category: this.category,
        urgency: this.urgency,
        description: this.description
      };
      if (this.roomId) {
        payload = {
          category: this.category,
          urgency: this.urgency,
          description: this.description,
          room_id: this.roomId
        };
      }
      const resp = await this.api.post('/service/repair', payload) as Record<string, Object>;
      if (resp['code'] === 0) {
        router.back();
      }
    } catch (e) {
      console.error('Submit failed:', JSON.stringify(e));
    }
  }

  build() {
    Column() {
      Row() {
        Text('æäº¤æŠ¥ä¿®').fontSize(20).fontWeight(FontWeight.Bold)
      }
      .width('100%').padding(16).backgroundColor('#FFF')

      Column() {
        Text('æŠ¥ä¿®ç±»å‹').fontSize(14).fontColor('#999').margin({ bottom: 8 })
        Row() {
          this.typeChip('æ°´ç”µ', 1)
          this.typeChip('é—¨çª—', 2)
          this.typeChip('ç®¡é“', 3)
          this.typeChip('å…¶ä»–', 7)
        }
      }
      .width('100%').padding(16).backgroundColor('#FFF').margin({ top: 8 })

      Column() {
        Text('ç´§æ€¥ç¨‹åº¦').fontSize(14).fontColor('#999').margin({ bottom: 8 })
        Row() {
          this.urgencyChip('æ™®é€š', 0)
          this.urgencyChip('ç´§æ€¥', 1)
          this.urgencyChip('éå¸¸ç´§æ€¥', 2)
        }
      }
      .width('100%').padding(16).backgroundColor('#FFF').margin({ top: 8 })

      Column() {
        Text('é—®é¢˜æè¿°').fontSize(14).fontColor('#999').margin({ bottom: 8 })
        TextArea({ placeholder: 'è¯·æè¿°æ‚¨é‡åˆ°çš„é—®é¢˜...', text: this.description })
          .height(120)
          .onChange((value: string) => { this.description = value; })
      }
      .width('100%').padding(16).backgroundColor('#FFF').margin({ top: 8 })

      Button('æäº¤æŠ¥ä¿®')
        .width('90%').margin({ top: 24 })
        .backgroundColor('#007AFF')
        .borderRadius(8)
        .onClick(() => { this.submit(); })
    }
    .width('100%').height('100%').backgroundColor('#F5F5F5')
  }

  @Builder typeChip(label: string, value: number) {
    Text(label)
      .fontSize(14)
      .fontColor(this.category === value ? '#FFF' : '#333')
      .backgroundColor(this.category === value ? '#007AFF' : '#E8E8E8')
      .borderRadius(8)
      .padding({ left: 16, right: 16, top: 8, bottom: 8 })
      .margin({ right: 8 })
      .onClick(() => { this.category = value; })
  }

  @Builder urgencyChip(label: string, value: number) {
    Text(label)
      .fontSize(14)
      .fontColor(this.urgency === value ? '#FFF' : '#333')
      .backgroundColor(this.urgency === value ? '#007AFF' : '#E8E8E8')
      .borderRadius(8)
      .padding({ left: 16, right: 16, top: 8, bottom: 8 })
      .margin({ right: 8 })
      .onClick(() => { this.urgency = value; })
  }
}
