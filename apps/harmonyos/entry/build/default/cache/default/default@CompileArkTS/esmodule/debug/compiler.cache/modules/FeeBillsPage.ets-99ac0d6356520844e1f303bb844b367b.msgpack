                                        Text.fontSize(11);
                                        Text.fontColor('#FFF');
                                        Text.backgroundColor(this.statusColor(bill.status));
                                        Text.borderRadius(4);
                                        Text.padding({ left: 8, right: 8, top: 2, bottom: 2 });
                                    }, Text);
                                    Text.pop();
                                    Row.pop();
                                    Column.pop();
                                    ListItem.pop();
                                };
                                this.observeComponentCreation2(itemCreation2, ListItem);
                                ListItem.pop();
