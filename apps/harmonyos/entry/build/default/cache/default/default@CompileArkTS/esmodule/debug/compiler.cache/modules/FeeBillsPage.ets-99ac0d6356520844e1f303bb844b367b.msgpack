                    }, Column);
                    this.observeComponentCreation2((elmtId, isInitialRender) => {
                        Text.create('æš‚æ— è´¦å•');
                        Text.fontSize(16);
                        Text.fontColor('#999');
                    }, Text);
                    Text.pop();
                    Column.pop();
                });
            }
            else {
                this.ifElseBranchUpdateFunction(2, () => {
                    this.observeComponentCreation2((elmtId, isInitialRender) => {
