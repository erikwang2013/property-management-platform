# ============================================================
# 开放管理后台 — 环境变量配置模板
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
#
# 使用方法: 复制此文件为 .env 并修改配置值
#   cp .env.example .env
#
# 注意: .env 文件包含敏感信息，已加入 .gitignore，切勿提交到版本库
# ============================================================

# ── 应用配置 ──
# 应用名称
APP_NAME=开放管理后台
# 调试模式: true=开启 false=关闭（生产环境务必关闭）
APP_DEBUG=false
# 应用URL
APP_URL=http://localhost:8787
# 监听地址（可选，覆盖 config/process.php 默认值，如 SERVER_LISTEN=http://0.0.0.0:8790）
SERVER_LISTEN=http://0.0.0.0:8787
# OpenAPI 文档开关: true=开启 /api/docs（生产环境建议关闭，避免暴露接口结构）
DOCS_ENABLED=false
# 日志级别: debug/info/notice/warning/error/critical/alert/emergency（config/log.php，默认 info）
LOG_LEVEL=info

# ── JWT 认证（erikwang2013/jwt-webman） ──
# 签名密钥，生产环境请使用 64 位以上随机字符串
JWT_SECRET_KEY=wr1aKVLWh4cTwk6vRPWZr3y8aMwXCNrMvVLL2sTKtXYeqs3Ya1PntRD7WeCLrbDv
# 签名算法: HS256 / HS384 / HS512 / RS256
JWT_ALGORITHM=HS256
# 访问令牌有效期（秒），默认 7200（2小时）
JWT_DEFAULT_EXPIRE=7200
# 刷新令牌有效期（秒），默认 1209600（14天）
JWT_REFRESH_EXPIRE=1209600
# 签发者标识
JWT_ISSUER=open-admin
# 受众标识
JWT_AUDIENCE=open-admin
# 时间偏移容忍（秒），默认 60
JWT_LEEWAY=60
# 令牌存储类型: file / redis / database，默认 file（插件默认）
JWT_STORAGE_TYPE=file
# 令牌存储数据库名（type=database 时使用，默认空）
JWT_STORAGE_DATABASE=
# 令牌存储键前缀（type=redis 时使用，默认 jwt_token:）
JWT_STORAGE_PREFIX=jwt_token:
# 黑名单重试次数，默认 1（插件默认）
JWT_ADVANCED_RETRY_ATTEMPTS=1
# 黑名单重试间隔（毫秒），默认 100（插件默认）
JWT_ADVANCED_RETRY_DELAY=100
# 过期令牌自动清理开关，默认 0=关闭（插件默认）
JWT_ADVANCED_AUTO_CLEANUP=0
# 自动清理间隔（秒），默认 3600（插件默认）
JWT_ADVANCED_CLEANUP_INTERVAL=3600

# ── Hashids ID 加解密（erikwang2013/hashids） ──
# 主连接盐值，生产环境务必修改为随机字符串
# 口径：admin 与 service 的盐必须不同（有意隔离，一端泄漏不至于对端 hashid 被反解）
HASHIDS_SALT=change-me-admin-hashids-salt
# 备用连接盐值（同上，与 service 端区分）
HASHIDS_ALT_SALT=change-me-admin-hashids-alt-salt

# ── Snowflake ID 生成（erikwang2013/snowflake-php） ──
# 数据中心 ID，取值范围 0-31，单机房保持默认
SNOWFLAKE_DATACENTER_ID=1
# 工作节点 ID，取值范围 0-31，同机房每台机器需不同
SNOWFLAKE_WORKER_ID=1
# 起始时间戳（毫秒），修改会导致已生成 ID 失效
SNOWFLAKE_START_TIMESTAMP=1700000000000

# ── API 传输层加密（erikwang2013/encryption） ──
# AES 加密密钥，生产环境使用 32 字节随机字符串
ENCRYPTION_KEY=4ba850e74e9dfbaad370f37d5411d6ea
# 加密算法: AES-256-CBC / sm4-ecb / sm4-cbc
ENCRYPTION_CIPHER=AES-256-CBC
# 初始化向量（IV），CBC 模式需要 16 字节，留空使用内置默认
ENCRYPTION_IV=

# ── 数据库存储层加密（erikwang2013/encryptable） ──
# 数据库敏感字段加密密钥，与传输密钥独立
# 注意: encryptable 插件也使用 ENCRYPTION_KEY 和 ENCRYPTION_CIPHER 这两个变量名
# 此处为数据库层单独配置，如需与传输层共用则保持相同值
ENCRYPTABLE_KEY=636bb1a24fbfefb1e9e352558eda711b
# 数据库加密算法: aes-128-ecb / aes-256-cbc
ENCRYPTABLE_CIPHER=AES-256-CBC
# 历史密钥列表（用于密钥轮换），逗号分隔
ENCRYPTION_PREVIOUS_KEYS=

# ── 国家/地区季节（erikwang2013/season） ──
# 默认国家代码（ISO 3166-1 alpha-2），决定默认季节计算，默认 CN
COUNTRY_SEASON_DEFAULT=CN

# ── 点击验证码（erikwang2013/poster-php） ──
# 图片处理驱动: auto / gd / imagick
POSTER_IMAGE_DRIVER=auto
# JPEG 输出质量 0-100
POSTER_IMAGE_QUALITY=90
# 验证码存储: auto / file / session / redis
POSTER_CAPTCHA_STORAGE=auto
# 验证码有效期（秒）
POSTER_CAPTCHA_TTL=300
# 同一 key 最大验证次数
POSTER_CAPTCHA_MAX_ATTEMPTS=3
# 默认难度: easy(2点) / medium(3点) / hard(4点)
POSTER_CAPTCHA_DIFFICULTY=medium

# ── 数据库连接 ──
# 数据库类型: mysql / pgsql / sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=management
DB_USERNAME=open_admin_user
DB_PASSWORD=

# ── Redis 连接 ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DATABASE=0

# ── CORS 跨域配置 ──
# 允许的来源域名，生产环境改为实际前端域名
CORS_ALLOWED_ORIGIN=http://localhost:8787

# ── Session 安全配置 ──
# Cookie Secure 标志（HTTPS 时开启），开发环境可设为 false
SESSION_SECURE=true
# Cookie SameSite 策略: Strict / Lax / None
SESSION_SAME_SITE=Strict

# ── Docker Compose 相关（docker-compose.yml 插值；Docker 专用模板见 .env.docker） ──
# 缺失或为空值时 docker compose config/up 直接报错；由 scripts/deploy.sh 自动补齐
# MySQL root 密码（compose 必填）
MYSQL_ROOT_PASSWORD=change-me-root-password
# Grafana 管理员密码（compose 必填）
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
# 注: REDIS_PASSWORD 同样被 compose 引用，为必填（见上文）
# 注: MySQL 容器的库名/用户/密码默认派生自 DB_DATABASE/DB_USERNAME/DB_PASSWORD（单一真源，
#     避免应用与容器两处不一致）；如需覆盖再显式设置（值必须与 DB_* 一致，否则应用连不上）:
# MYSQL_DATABASE=management
# MYSQL_USER=open_admin_user
# MYSQL_PASSWORD=
# 端口覆盖（可选，默认如下；同主机双栈时 service 端需错开，见 service/.env.docker）:
# NGINX_PORT=80
# NGINX_SSL_PORT=443
# MYSQL_PORT=3306
# REDIS_PORT=6379
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ── 支付凭证（config/payment.php） ──
# 总开关 + 环境切换: sandbox=沙箱 / production=生产
PAYMENT_ENABLED=false
PAYMENT_ENVIRONMENT=sandbox
# 回调公网地址前缀（不带末尾斜杠），用于拼装 notify_url
PAYMENT_NOTIFY_HOST=http://localhost:8787
PAYMENT_TIMEOUT=10
# ── 微信支付（Native 扫码） ──
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_CERT=
# ── 支付宝（当面付-预下单） ──
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
