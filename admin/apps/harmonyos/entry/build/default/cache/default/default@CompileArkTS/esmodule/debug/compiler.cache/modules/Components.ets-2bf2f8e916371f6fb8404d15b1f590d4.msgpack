/**
 * ç»Ÿè®¡å¡ç‰‡ç»„ä»¶
 */
@Component
export struct StatCard {
  @Prop label: string = '';
  @Prop value: string = '';
  @Prop icon: string = 'people';
  @Prop color: string = '#1677FF';
  @Prop trend: number | null = null;

  build() {
    Column() {
      Row() {
        Image($rawfile(`${this.icon}.png`))
          .width(20)
          .height(20)
          .fillColor(this.color)
      }
      .justifyContent(FlexAlign.Start)

      Blank()

      Text(this.label)
        .fontSize(12)
        .fontColor('#666666')
        .margin({ top: 4 })

      Text(this.value)
        .fontSize(24)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.color)
        .margin({ top: 2 })
    }
    .width('100%')
    .height(110)
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(8)
    .shadow({ radius: 4, color: '#00000010', offsetY: 2 })
  }
}

/**
 * åŠ è½½çŠ¶æ€ç»„ä»¶
 */
@Component
export struct LoadingView {
  @Prop message: string = 'åŠ è½½ä¸­...';

  build() {
    Column() {
      LoadingProgress()
        .width(40)
        .height(40)
        .color('#1677FF')

      Text(this.message)
        .fontSize(14)
        .fontColor('#999999')
        .margin({ top: 12 })
    }
    .justifyContent(FlexAlign.Center)
    .width('100%')
    .height('100%')
  }
}

/**
 * ç©ºçŠ¶æ€ç»„ä»¶
 */
@Component
export struct EmptyView {
  @Prop message: string = 'æš‚æ— æ•°æ®';

  build() {
    Column() {
      Image($rawfile('empty.png'))
        .width(120)
        .height(120)
        .objectFit(ImageFit.Contain)

      Text(this.message)
        .fontSize(14)
        .fontColor('#999999')
        .margin({ top: 12 })
    }
    .justifyContent(FlexAlign.Center)
    .width('100%')
    .height('100%')
  }
}

/**
 * é”™è¯¯çŠ¶æ€ç»„ä»¶
 */
@Component
export struct ErrorView {
  @Prop message: string = 'åŠ è½½å¤±è´¥';
  onRetry?: () => void;

  build() {
    Column() {
      Text(this.message)
        .fontSize(14)
        .fontColor('#999999')

      Button('é‡è¯•')
        .margin({ top: 12 })
        .fontSize(14)
        .onClick(() => {
          if (this.onRetry) {
            this.onRetry();
          }
        })
    }
    .justifyContent(FlexAlign.Center)
    .width('100%')
    .height('100%')
  }
}

