import router from '@ohos.router';
import promptAction from '@ohos.promptAction';
import http from '@ohos.net.http';
import { TokenManager } from '../utils/TokenManager';

// å¼€å‘ç¯å¢ƒåœ°å€ â€” çœŸæœºéƒ¨ç½²æ—¶ä¿®æ”¹ä¸ºå®é™…æœåŠ¡å™¨åœ°å€
// æ¨¡æ‹Ÿå™¨: http://10.0.2.2:8787
// çœŸæœº: http://<æœåŠ¡å™¨IP>:8787
const BASE_URL = 'http://10.0.2.2:8787';

interface CaptchaTarget {
  order: number;
  text: string;
  x: number;
  y: number;
}

interface CaptchaData {
  key: string;
  image: string; // base64
  targets: CaptchaTarget[];
}

interface ClickPoint {
  x: number;
  y: number;
}

interface ClickMarker {
  x: number;
  y: number;
  order: number;
}

@Entry
@Component
struct LoginPage {
  @State username: string = '';
  @State password: string = '';
  @State isLoading: boolean = false;
  @State showPassword: boolean = false;

  // éªŒè¯ç çŠ¶æ€
  @State captchaData: CaptchaData | null = null;
  @State captchaLoading: boolean = true;
  @State clicks: ClickPoint[] = [];
  @State clickMarkers: ClickMarker[] = [];
  @State captchaError: string = '';
  @State loginError: string = '';

  private httpClient: http.HttpRequest = http.createHttp();

  aboutToAppear(): void {
    this.loadCaptcha();
  }

  async loadCaptcha(): Promise<void> {
    this.captchaLoading = true;
    this.clicks = [];
    this.clickMarkers = [];
    this.captchaError = '';

    try {
      const resp = await this.httpClient.request(`${BASE_URL}/api/captcha/generate`, {
        method: http.RequestMethod.POST,
        header: { 'Content-Type': 'application/json', 'API-Version': 'v1', 'X-Client-Platform': 'harmonyos' },
        extraData: JSON.stringify({ difficulty: 'medium' }),
        connectTimeout: 10000,
        readTimeout: 10000
      });

      const result = JSON.parse(resp.result as string) as Record<string, Object>;
      if (result['code'] === 0) {
        this.captchaData = result['data'] as CaptchaData;
        this.captchaData!.targets.sort((a, b) => a.order - b.order);
      } else {
        this.captchaError = 'éªŒè¯ç åŠ è½½å¤±è´¥';
      }
    } catch (e) {
      this.captchaError = 'ç½‘ç»œé”™è¯¯ï¼Œæ— æ³•åŠ è½½éªŒè¯ç ';
    } finally {
      this.captchaLoading = false;
    }
  }

  onCaptchaClick(event: ClickEvent): void {
    if (!this.captchaData || this.clicks.length >= this.captchaData.targets.length) return;

    // ç‚¹å‡»åæ ‡ (ç›¸å¯¹äºç»„ä»¶)
    const widgetW = 400; // ç»„ä»¶è¿‘ä¼¼å®½åº¦
    const widgetH = 250;
    const imgW = 400;
    const imgH = 250;
    const scaleX = imgW / widgetW;
    const scaleY = imgH / widgetH;
    const imgX = Math.round(event.x * scaleX);
    const imgY = Math.round(event.y * scaleY);

    const order = this.clicks.length;
    this.clicks.push({ x: imgX, y: imgY });
    this.clickMarkers.push({ x: event.x, y: event.y, order: order + 1 });
    this.captchaError = '';
    this.loginError = '';
  }

  async login(): Promise<void> {
    const trimmedUsername = this.username.trim();
    if (!trimmedUsername) {
      this.loginError = 'è¯·è¾“å…¥ç”¨æˆ·å';
      return;
    }
    if (!this.password) {
      this.loginError = 'è¯·è¾“å…¥å¯†ç ';
      return;
    }
    if (!this.captchaData || this.clicks.length < this.captchaData.targets.length) {
      const next = this.captchaData?.targets[this.clicks.length];
      this.loginError = next ? `è¯·ç‚¹å‡»å›¾ä¸­æ–‡å­—ã€${next.text}ã€` : 'è¯·å®ŒæˆéªŒè¯ç éªŒè¯';
      return;
    }

    this.isLoading = true;
    this.loginError = '';

    try {
      const resp = await this.httpClient.request(`${BASE_URL}/api/auth/login`, {
        method: http.RequestMethod.POST,
        header: { 'Content-Type': 'application/json', 'API-Version': 'v1', 'X-Client-Platform': 'harmonyos' },
        extraData: JSON.stringify({
          username: trimmedUsername,
          password: this.password,
          captcha_key: this.captchaData!.key,
          clicks: this.clicks
        }),
        connectTimeout: 15000,
        readTimeout: 15000
      });

      const result = JSON.parse(resp.result as string) as Record<string, Object>;
      if (result['code'] === 0) {
        const tokenData = result['data'] as Record<string, Object>;
        await TokenManager.saveTokens(tokenData['access_token'] as string, tokenData['refresh_token'] as string);
        AppStorage.setOrCreate('adminUsername', trimmedUsername);
        router.replaceUrl({ url: 'pages/DashboardPage' });
      } else {
        this.loginError = (result['message'] as string) ?? 'ç™»å½•å¤±è´¥';
        this.loadCaptcha();
      }
    } catch (e) {
      this.loginError = 'ç½‘ç»œé”™è¯¯ï¼Œè¯·æ£€æŸ¥è¿æ¥';
      this.loadCaptcha();
    } finally {
      this.isLoading = false;
    }
  }

  build() {
    Column() {
      Scroll() {
        Column() {
          // é¡¶éƒ¨å“ç‰ŒåŒº
          Column() {
            Image($rawfile('logo.png'))
              .width(64)
              .height(64)
              .margin({ bottom: 8 })

            Text('å¼€æ”¾ç®¡ç†åå°')
              .fontSize(22)
              .fontWeight(FontWeight.Bold)
              .fontColor('#1677FF')

            Text('HarmonyOS å®¢æˆ·ç«¯')
              .fontSize(12)
              .fontColor('#999999')
              .margin({ top: 2 })
          }
          .width('100%')
          .padding({ top: 40, bottom: 24 })
          .justifyContent(FlexAlign.Center)

          // è¡¨å•åŒº
          Column() {
            // ç”¨æˆ·å
            TextInput({ placeholder: 'è¯·è¾“å…¥ç”¨æˆ·å', text: this.username })
              .height(48)
              .fontSize(15)
              .backgroundColor('#F5F5F5')
              .borderRadius(8)
              .padding({ left: 16, right: 16 })
              .onChange((v: string) => { this.username = v; })

            // å¯†ç 
            Row() {
              TextInput({ placeholder: 'è¯·è¾“å…¥å¯†ç ', text: this.password })
                .height(48)
                .fontSize(15)
                .type(this.showPassword ? InputType.Normal : InputType.Password)
                .backgroundColor('#F5F5F5')
                .borderRadius(8)
                .padding({ left: 16, right: 16 })
                .layoutWeight(1)
                .onChange((v: string) => { this.password = v; })

              Button(this.showPassword ? 'éšè—' : 'æ˜¾ç¤º')
                .fontSize(12)
                .fontColor('#1677FF')
                .backgroundColor(Color.Transparent)
                .width(56)
                .onClick(() => { this.showPassword = !this.showPassword; })
            }
            .width('100%')
            .margin({ top: 14 })

            // ç‚¹å‡»éªŒè¯ç 
            if (this.captchaLoading) {
              LoadingProgress()
                .width(36)
                .height(36)
                .color('#1677FF')
                .margin({ top: 16 })
            } else if (this.captchaError && !this.captchaData) {
              Row() {
                Text(this.captchaError)
                  .fontSize(13)
                  .fontColor('#FF4D4F')
                  .layoutWeight(1)
                Button('é‡è¯•')
                  .fontSize(13)
                  .fontColor('#1677FF')
                  .backgroundColor(Color.Transparent)
                  .onClick(() => { this.loadCaptcha(); })
              }
              .width('100%')
              .margin({ top: 14 })
            } else if (this.captchaData) {
              Column() {
                // æç¤ºæ–‡å­—
                Row() {
                  Text('è¯·æŒ‰é¡ºåºç‚¹å‡»å›¾ä¸­æ–‡å­—: ')
                    .fontSize(12)
                    .fontColor('#666666')
                  ForEach(this.captchaData!.targets, (t: CaptchaTarget, i: number) => {
                    Text(i > 0 ? ' â†’ ' : '')
                      .fontSize(12)
                      .fontColor('#999999')
                    Text(`"${t.text}"`)
                      .fontSize(13)
                      .fontWeight(this.clicks.length === i ? FontWeight.Bold : FontWeight.Normal)
                      .fontColor(this.clicks.length > i ? '#52C41A' : (this.clicks.length === i ? '#1677FF' : '#333333'))
                  })
                }
                .width('100%')
                .margin({ top: 14, bottom: 6 })

                // éªŒè¯ç å›¾ç‰‡
                Stack({ alignContent: Alignment.TopStart }) {
                  Image((this.captchaData!.image.startsWith('data:') ?? false)
                    ? this.captchaData!.image
                    : `data:image/png;base64,${this.captchaData!.image}`)
                    .width('100%')
                    .height(200)
                    .objectFit(ImageFit.Contain)
                    .borderRadius(8)
                    .border({ width: 1, color: '#EEEEEE' })
                    .onClick((event: ClickEvent) => { this.onCaptchaClick(event); })

                  // ç‚¹å‡»æ ‡è®°
                  ForEach(this.clickMarkers, (m: ClickMarker) => {
                    Circle({ width: 26, height: 26 })
                      .fill('#1677FFCC')
                      .position({ x: m.x - 13, y: m.y - 13 })
                    Text(`${m.order}`)
                      .fontSize(13)
                      .fontColor('#FFFFFF')
                      .fontWeight(FontWeight.Bold)
                      .position({ x: m.x - 3, y: m.y - 8 })
                  })
                }
                .width('100%')
                .height(200)
                .margin({ top: 4 })

                // æ“ä½œæ 
                Row() {
                  Text(`å·²ç‚¹å‡» ${this.clicks.length}/${this.captchaData!.targets.length}`)
                    .fontSize(12)
                    .fontColor('#999999')

                  Blank()

                  Button('æ¢ä¸€å¼ ')
                    .fontSize(12)
                    .fontColor('#1677FF')
                    .backgroundColor(Color.Transparent)
                    .onClick(() => { this.loadCaptcha(); })
                }
                .width('100%')
                .margin({ top: 4 })
              }
              .width('100%')
            }

            // é”™è¯¯æç¤º
            if (this.loginError) {
              Text(this.loginError)
                .fontSize(13)
                .fontColor('#FF4D4F')
                .width('100%')
                .textAlign(TextAlign.Center)
                .padding({ top: 10, bottom: 2 })
            }

            // ç™»å½•æŒ‰é’®
            Button('ç™» å½•')
              .width('100%')
              .height(48)
              .fontSize(16)
              .fontColor('#FFFFFF')
              .backgroundColor(this.isLoading ? '#99BBFF' : '#1677FF')
              .borderRadius(8)
              .margin({ top: 20 })
              .enabled(!this.isLoading)
              .onClick(() => { this.login(); })
          }
          .width('100%')
          .padding({ left: 28, right: 28 })

          // åº•éƒ¨æ“ä½œ
          Row() {
            Text('è¿˜æ²¡æœ‰è´¦å·ï¼Ÿ')
              .fontSize(13)
              .fontColor('#999999')
            Button('ç«‹å³æ³¨å†Œ')
              .fontSize(13)
              .fontColor('#1677FF')
              .backgroundColor(Color.Transparent)
              .onClick(() => {
                promptAction.showToast({ message: 'æ³¨å†ŒåŠŸèƒ½å³å°†ä¸Šçº¿' });
              })
          }
          .justifyContent(FlexAlign.Center)
          .margin({ top: 16 })

          // ç‰ˆæƒ
          Text('Copyright (c) 2026 erik â€” https://erik.xyz')
            .fontSize(10)
            .fontColor('#CCCCCC')
            .textAlign(TextAlign.Center)
            .width('100%')
            .padding({ top: 20, bottom: 24 })
        }
        .width('100%')
      }
      .width('100%')
      .layoutWeight(1)
      .scrollable(ScrollDirection.Vertical)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FFFFFF')
  }
}
