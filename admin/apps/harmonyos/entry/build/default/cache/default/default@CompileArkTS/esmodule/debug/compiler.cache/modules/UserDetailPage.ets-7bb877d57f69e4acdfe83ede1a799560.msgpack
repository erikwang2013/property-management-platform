import router from '@ohos.router';
import promptAction from '@ohos.promptAction';
import { UserService } from '../service/DataService';
import { User } from '../model/DataModels';
import { LoadingView, ErrorView } from '../common/Components';

@Entry
@Component
struct UserDetailPage {
  @State user: User | null = null;
  @State isLoading: boolean = true;
  @State hasError: boolean = false;
  @State isSubmitting: boolean = false;
  @State mode: string = 'view';
  @State userId: string = '';

  // è¡¨å•çŠ¶æ€
  @State formUsername: string = '';
  @State formRealName: string = '';
  @State formPhone: string = '';
  @State formEmail: string = '';
  @State formPassword: string = '';
  @State formStatus: number = 1;

  aboutToAppear(): void {
    const params = (router.getParams() ?? {}) as Record<string, Object>;
    this.mode = (params?.['mode'] as string) ?? 'view';
    this.userId = (params?.['userId'] as string) ?? '';

    if (this.mode !== 'create') {
      this.loadDetail();
    } else {
      this.isLoading = false;
    }
  }

  async loadDetail(): Promise<void> {
    this.isLoading = true;
    try {
      this.user = await UserService.getDetail(this.userId);
      this.formUsername = this.user.username;
      this.formRealName = this.user.real_name;
      this.formPhone = this.user.phone ?? '';
      this.formEmail = this.user.email ?? '';
      this.formStatus = this.user.status;
    } catch (e) {
      if (e instanceof Error && e.message === 'UNAUTHORIZED') {
        router.replaceUrl({ url: 'pages/LoginPage' });
        return;
      }
      this.hasError = true;
    } finally {
      this.isLoading = false;
    }
  }

  async save(): Promise<void> {
    if (!this.formUsername.trim()) {
      promptAction.showToast({ message: 'è¯·è¾“å…¥ç”¨æˆ·å' });
      return;
    }
    if (this.mode === 'create' && !this.formPassword) {
      promptAction.showToast({ message: 'è¯·è¾“å…¥å¯†ç ' });
      return;
    }

    this.isSubmitting = true;
    try {
      if (this.mode === 'create') {
        await UserService.create({
          username: this.formUsername,
          real_name: this.formRealName,
          password: this.formPassword,
          phone: this.formPhone,
          email: this.formEmail,
          status: this.formStatus
        });
        promptAction.showToast({ message: 'åˆ›å»ºæˆåŠŸ' });
      } else {
        await UserService.update(this.userId, {
          real_name: this.formRealName,
          phone: this.formPhone,
          email: this.formEmail,
          status: this.formStatus
        });
        promptAction.showToast({ message: 'æ›´æ–°æˆåŠŸ' });
      }
      router.back();
    } catch (e) {
      if (e instanceof Error && e.message === 'UNAUTHORIZED') {
        router.replaceUrl({ url: 'pages/LoginPage' });
        return;
      }
      promptAction.showToast({ message: 'ä¿å­˜å¤±è´¥' });
    } finally {
      this.isSubmitting = false;
    }
  }

  async deleteUser(): Promise<void> {
    AlertDialog.show({
      title: 'ç¡®è®¤åˆ é™¤',
      message: 'ç¡®å®šè¦åˆ é™¤è¯¥ç”¨æˆ·å—ï¼Ÿåˆ é™¤åä¸å¯æ¢å¤ã€‚',
      autoCancel: true,
      alignment: DialogAlignment.Center,
      primaryButton: {
        value: 'ç¡®å®š',
        fontColor: '#FF4D4F',
        action: async () => {
          try {
            await UserService.delete(this.userId);
            promptAction.showToast({ message: 'åˆ é™¤æˆåŠŸ' });
            router.back();
          } catch (e) {
            if (e instanceof Error && e.message === 'UNAUTHORIZED') {
              router.replaceUrl({ url: 'pages/LoginPage' });
              return;
            }
            promptAction.showToast({ message: 'åˆ é™¤å¤±è´¥' });
          }
        }
      },
      secondaryButton: {
        value: 'å–æ¶ˆ',
        action: () => {}
      }
    });
  }

  build() {
    Column() {
      // é¡¶æ 
      Row() {
        Button({ type: ButtonType.Circle }) {
          Image($rawfile('back.png')).width(24).height(24)
        }
        .width(36).height(36)
        .backgroundColor('#FFFFFF')
        .onClick(() => router.back())

        Text(this.mode === 'create' ? 'æ–°å¢ç”¨æˆ·' : 'ç”¨æˆ·è¯¦æƒ…')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .margin({ left: 8 })

        Blank()

        if (this.mode !== 'create') {
          Button('åˆ é™¤')
            .fontSize(13)
            .fontColor('#FF4D4F')
            .backgroundColor('#FFE6E6')
            .borderRadius(4)
            .height(32)
            .onClick(() => this.deleteUser())
        }
      }
      .width('100%')
      .height(56)
      .padding({ left: 16, right: 16 })
      .backgroundColor('#FFFFFF')

      if (this.isLoading) {
        LoadingView();
      } else if (this.hasError) {
        ErrorView({ onRetry: () => this.loadDetail() });
      } else {
        Scroll() {
          Column() {
            // å¤´åƒ
            Circle({ width: 72, height: 72 })
              .fill('#E6F0FF')
              .margin({ top: 24, bottom: 24 })

            // è¡¨å•ï¼ˆè¡Œå†…ç›´æ¥å†…è”ï¼Œé¿å…åœ¨ @Builder ä¸­è°ƒç”¨å‡½æ•°å‚æ•°ï¼‰
            Row() {
              Text('ç”¨æˆ·å')
                .fontSize(15)
                .fontColor('#333333')
                .width(80)

              TextInput({ placeholder: 'è¯·è¾“å…¥ç”¨æˆ·å', text: this.formUsername })
                .fontSize(15)
                .layoutWeight(1)
                .enabled(this.mode === 'create')
                .onChange((v: string) => { this.formUsername = v; })
            }
            .width('100%')
            .height(56)
            .padding({ left: 16, right: 16 })
            .backgroundColor('#FFFFFF')
            .border({ width: { bottom: 0.5 }, color: '#EEEEEE' })
            .alignItems(VerticalAlign.Center)

            if (this.mode === 'create') {
              Row() {
                Text('å¯†ç ')
                  .fontSize(15)
                  .fontColor('#333333')
                  .width(80)

                TextInput({ placeholder: 'è¯·è¾“å…¥å¯†ç ', text: this.formPassword })
                  .fontSize(15)
                  .layoutWeight(1)
                  .type(InputType.Password)
                  .onChange((v: string) => { this.formPassword = v; })
              }
              .width('100%')
              .height(56)
              .padding({ left: 16, right: 16 })
              .backgroundColor('#FFFFFF')
              .border({ width: { bottom: 0.5 }, color: '#EEEEEE' })
              .alignItems(VerticalAlign.Center)
            }

            Row() {
              Text('å§“å')
                .fontSize(15)
                .fontColor('#333333')
                .width(80)

              TextInput({ placeholder: 'è¯·è¾“å…¥çœŸå®å§“å', text: this.formRealName })
                .fontSize(15)
                .layoutWeight(1)
                .onChange((v: string) => { this.formRealName = v; })
            }
            .width('100%')
            .height(56)
            .padding({ left: 16, right: 16 })
            .backgroundColor('#FFFFFF')
            .border({ width: { bottom: 0.5 }, color: '#EEEEEE' })
            .alignItems(VerticalAlign.Center)

            Row() {
              Text('æ‰‹æœºå·')
                .fontSize(15)
                .fontColor('#333333')
                .width(80)

              TextInput({ placeholder: 'è¯·è¾“å…¥æ‰‹æœºå·', text: this.formPhone })
                .fontSize(15)
                .layoutWeight(1)
                .type(InputType.PhoneNumber)
                .onChange((v: string) => { this.formPhone = v; })
            }
            .width('100%')
            .height(56)
            .padding({ left: 16, right: 16 })
            .backgroundColor('#FFFFFF')
            .border({ width: { bottom: 0.5 }, color: '#EEEEEE' })
            .alignItems(VerticalAlign.Center)

            Row() {
              Text('é‚®ç®±')
                .fontSize(15)
                .fontColor('#333333')
                .width(80)

              TextInput({ placeholder: 'è¯·è¾“å…¥é‚®ç®±', text: this.formEmail })
                .fontSize(15)
                .layoutWeight(1)
                .type(InputType.Email)
                .onChange((v: string) => { this.formEmail = v; })
            }
            .width('100%')
            .height(56)
            .padding({ left: 16, right: 16 })
            .backgroundColor('#FFFFFF')
            .border({ width: { bottom: 0.5 }, color: '#EEEEEE' })
            .alignItems(VerticalAlign.Center)

            // çŠ¶æ€è¡Œï¼ˆç›´æ¥å†…è”ï¼Œé¿å…åœ¨å›è°ƒä¸­ä¹¦å†™ç»„ä»¶å—ï¼‰
            Row() {
              Text('çŠ¶æ€')
                .fontSize(15)
                .fontColor('#333333')
                .width(80)

              Row() {
                Button('å¯ç”¨')
                  .fontSize(13)
                  .fontColor(this.formStatus === 1 ? '#FFFFFF' : '#666666')
                  .backgroundColor(this.formStatus === 1 ? '#52C41A' : '#F5F5F5')
                  .borderRadius(4)
                  .height(32)
                  .onClick(() => { this.formStatus = 1; })

                Button('ç¦ç”¨')
                  .fontSize(13)
                  .fontColor(this.formStatus === 0 ? '#FFFFFF' : '#666666')
                  .backgroundColor(this.formStatus === 0 ? '#FF4D4F' : '#F5F5F5')
                  .borderRadius(4)
                  .height(32)
                  .margin({ left: 12 })
                  .onClick(() => { this.formStatus = 0; })
              }
              .layoutWeight(1)
            }
            .width('100%')
            .height(56)
            .padding({ left: 16, right: 16 })
            .backgroundColor('#FFFFFF')
            .border({ width: { bottom: 0.5 }, color: '#EEEEEE' })
            .alignItems(VerticalAlign.Center)

            // æäº¤æŒ‰é’®
            Button('ä¿ å­˜')
              .width('100%')
              .height(48)
              .fontSize(16)
              .fontColor('#FFFFFF')
              .backgroundColor(this.isSubmitting ? '#99BBFF' : '#1677FF')
              .borderRadius(8)
              .margin({ top: 32, left: 16, right: 16, bottom: 32 })
              .enabled(!this.isSubmitting)
              .onClick(() => { this.save(); })
          }
          .width('100%')
        }
        .width('100%')
        .layoutWeight(1)
        .backgroundColor('#F5F5F5')
      }
    }
    .width('100%')
    .height('100%')
  }

}
