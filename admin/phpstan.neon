includes:
    - phpstan-baseline.neon

parameters:
  level: 5
  paths:
    - app/
  excludePaths:
    - vendor/
    # runtime/ 被 .gitignore 忽略，全新 CI 检出时不存在；(?) 标记为可选路径
    - runtime (?)
    - tests/
    # webman/redis-queue 未安装，队列消费者为预留代码，暂不纳入分析
    - app/queue/
  # illuminate 系列包 psr-4 目标为 ""，PHPStan 自动发现会解析失败，需显式扫描
  scanDirectories:
    - vendor/illuminate/database
    - vendor/illuminate/contracts
    - vendor/illuminate/support
